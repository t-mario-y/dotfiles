% Deno
# deno eval instead of jq
echo '{"name": "Mario"}' | deno eval --print 'JSON.parse(Deno.readTextFileSync("/dev/stdin")).name'

% yarn
# see package dependency from specific package
yarn why 

# audit only critical in dependencies
yarn audit --group dependencies --level critical

# deno serve static file by SERVE_DIR
PORT=8080 SERVE_DIR=coverage deno run --allow-all ~/dotfiles/utils/serve_dir.ts
